{
  "name": "blog",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "vitepress dev",
    "build": "vue-tsc -b && vitepress build",
    "preview": "vitepress preview",
    "lint": "eslint . -f mo",
    "fix": "eslint . -f mo --fix",
    "typecheck": "vue-tsc -b",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@floating-ui/vue": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/integrations": "catalog:",
    "cva": "catalog:",
    "focus-trap": "catalog:",
    "gitalk": "catalog:",
    "mark.js": "catalog:",
    "markstream-vue": "catalog:",
    "medium-zoom": "catalog:",
    "minisearch": "catalog:",
    "tailwind-merge": "catalog:",
    "unocss": "catalog:",
    "vitepress-plugin-group-icons": "catalog:",
    "vue": "catalog:",
    "vue-sonner": "catalog:",
    "zdog": "catalog:"
  },
  "devDependencies": {
    "@bernankez/eslint-config": "catalog:",
    "@bernankez/theme": "catalog:",
    "@iconify-json/line-md": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@nolebase/vitepress-plugin-git-changelog": "catalog:",
    "@shikijs/vitepress-twoslash": "catalog:",
    "@types/mark.js": "catalog:",
    "@types/node": "catalog:",
    "@types/zdog": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-mini": "catalog:",
    "@unocss/reset": "catalog:",
    "@unplugin-pwa/core": "catalog:",
    "@vite-pwa/assets-generator": "catalog:",
    "@vite-pwa/vitepress": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "confbox": "catalog:",
    "eslint": "catalog:",
    "eslint-formatter-mo": "catalog:",
    "eslint-plugin-format": "catalog:",
    "gray-matter": "catalog:",
    "lint-staged": "catalog:",
    "magicast": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-lightbox": "catalog:",
    "vitepress-plugin-llms": "catalog:",
    "vitepress-plugin-rss": "catalog:",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint ."
    ]
  }
}
